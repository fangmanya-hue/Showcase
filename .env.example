# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "FlowDesk"
NEXT_PUBLIC_DEFAULT_LOCALE = "zh"
NEXT_PUBLIC_SUPPORT_EMAIL = ""

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
AUTH_URL = "http://localhost:3000"
GOOGLE_AUTH_ENABLED = "false"
GOOGLE_ONE_TAP_ENABLED = "false"
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""

# FlowDesk AI extraction (server-side only)
EVOLINK_API_KEY = ""
FLOWDESK_AI_BASE_URL = "https://direct.evolink.ai"
FLOWDESK_AI_MODEL = "deepseek-v4-pro"
FLOWDESK_AI_REVIEW_MODEL = "deepseek-v4-pro"
